{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "sh ~/.bob/hooks/session-start.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^write_file$",
        "hooks": [{ "type": "command", "command": "sh ~/.bob/hooks/log-writes.sh" }]
      }
    ]
  }
}
